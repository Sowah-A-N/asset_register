# Application
APP_NAME="Asset Register"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/asset_register/app_v3/public

# Database — main (asset_register_new)
DB_HOST=localhost
DB_NAME=asset_register_new
DB_USER=root
DB_PASS=

# Database — DSU legacy (asset_register)
DSU_DB_HOST=localhost
DSU_DB_NAME=asset_register
DSU_DB_USER=root
