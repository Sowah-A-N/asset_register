# ── Block direct access to secrets and config files ───────────────────────────
<FilesMatch "^\.env(\..*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Disable directory listing ──────────────────────────────────────────────────
Options -Indexes
