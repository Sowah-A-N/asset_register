# Copy this file to .env, fill in real values, and NEVER commit .env.

# ── Main database (asset_register_new) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=asset_register_new
DB_USER=assets
DB_PASS=CHANGE_ME

# ── DSU legacy database (asset_register) ─────────────────────────────────────
# Uses the same host/user/pass as main; only the database name differs.
DB_NAME_DSU=asset_register

# ── Registry database (roommanagement) ───────────────────────────────────────
DB_NAME_REG=roommanagement
DB_USER_REG=CHANGE_ME
DB_PASS_REG=CHANGE_ME

# ── Mail (PHPMailer — used by forgot-password) ────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASS=CHANGE_ME
MAIL_FROM_NAME="RMU Asset Register"

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production     # production | development
